{
  "$schema": "https://tauri.app/v2/api/config",
  "productName": "9router",
  "version": "0.5.111",
  "identifier": "com.decolua.9router",
    "build": {
      "frontendDist": "frontend-dist",
      "devUrl": "",
      "beforeDevCommand": "",
      "beforeBuildCommand": ""
    },
  "app": {
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "src-tauri/icons/icon.ico"
    ],
    "resources": [
      "resources/*"
    ],
    "windows": [
      {
        "certificateThumbprint": "",
        "digestAlgorithm": "sha256",
        "timestampUrl": ""
      }
    ]
  }
}
